FROM eclipse-temurin:17-jre-jammy

RUN apt-get update && \
    apt-get install -y curl netcat-openbsd && \
    rm -rf /var/lib/apt/lists/*

ENV SPARK_HOME=/opt/spark
ENV PATH=${SPARK_HOME}/bin:${SPARK_HOME}/sbin:${PATH}

# setup.sh merges extra-jars/*.jar (hadoop-aws, bundle-2.24.6 without Netty) directly
# into spark-4.1.1/jars/ before docker build, so a single COPY puts everything in the
# right place without creating a duplicate Docker layer for the 533 MB bundle.
COPY spark-4.1.1/ /opt/spark/

RUN mkdir -p /var/lib/spark/work
WORKDIR /opt/spark
