FROM europe-west1-docker.pkg.dev/practicacreativa-497711/practica/spark-base:4.1.1

# netcat for port-readiness checks, curl for mc download
RUN apt-get update && apt-get install -y netcat-openbsd curl && \
    # Install MinIO client (mc)
    curl -fsSL https://dl.min.io/client/mc/release/linux-amd64/mc \
         -o /usr/local/bin/mc && \
    chmod +x /usr/local/bin/mc && \
    rm -rf /var/lib/apt/lists/*

WORKDIR /app

# JAR built by: sbt package  (inside flight_prediction/)
COPY target/scala-2.13/flight_prediction_2.13-0.1.jar .

COPY entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

ENV KAFKA_HOST=kafka
ENV MINIO_HOST=minio
ENV CASSANDRA_HOST=cassandra

ENTRYPOINT ["/entrypoint.sh"]